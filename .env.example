# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barnbuddy
DB_USER=barnbuddy
DB_PASSWORD=barnbuddy_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=BanditBuddyBot
TELEGRAM_WEBHOOK_SECRET=random_secret_for_webhook_verification
APP_URL=https://bandit.wvnd.vn

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Web3 / BSC
SIGNER_PRIVATE_KEY=your_admin_wallet_private_key_never_commit_this
BSC_RPC_URL=https://bsc-dataseed.binance.org/
FARM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
CLAIM_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Anti-bot
MIN_TRUST_SCORE=30

# Admin API (internal tool — set a strong random passphrase)
ADMIN_PASSCODE=change_this_to_a_strong_random_passphrase

# Seasonal events: none | halloween | christmas | lunar
SEASONAL_EVENT=none
