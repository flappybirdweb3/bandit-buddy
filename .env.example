# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barnbuddy
DB_USER=barnbuddy
DB_PASSWORD=barnbuddy_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=BanditBuddyBot
TELEGRAM_WEBHOOK_SECRET=random_secret_for_webhook_verification
APP_URL=https://bandit.wvnd.vn

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Web3 / BSC
SIGNER_PRIVATE_KEY=your_admin_wallet_private_key_never_commit_this
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_WSS_URL=wss://bsc-testnet.nodereal.io/ws/v1/YOUR_KEY_HERE
FARM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
FARM_VESTING_ADDRESS=0x0000000000000000000000000000000000000000
ECOSYSTEM_WALLET=0xfdbA9c99698623f4b316dB2c48757cf04065FFc8
CLAIM_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0xB622a23F16DFFc40A782D5B71C50819C417a0fb5

# PancakeSwap DEX integration
PANCAKE_FACTORY_ADDRESS=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
PANCAKE_ROUTER_ADDRESS=0x10ED43C718714eb63d5aA57B78B54704E256024E
PANCAKE_PAIR_ADDRESS=0x0000000000000000000000000000000000000000
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# Anti-bot
MIN_TRUST_SCORE=30

# Admin API (internal tool — set a strong random passphrase)
ADMIN_PASSCODE=change_this_to_a_strong_random_passphrase

# Seasonal events: none | halloween | christmas | lunar
SEASONAL_EVENT=none
